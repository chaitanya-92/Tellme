{
  "manifest_version": 3,
  "name": "Tellme — Web, Spoken",
  "version": "0.5.0",
  "description": "Read the useful parts of webpages, Reddit posts, comments and replies aloud while you browse.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "action": {
    "default_title": "Tellme",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "send-page-to-tellme": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Read the current page with Tellme"
    }
  }
}